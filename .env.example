# Copy to .env and fill in. Three paths, and only the first is mandatory
# thinking - the other two are wherever your disks already are.

# Your provider's WireGuard device configs live here: wg0.conf, wg1.conf,
# wg2.conf. Download three devices on DIFFERENT servers from your VPN account.
# BondVPN reads whatever .conf files it finds, in name order, and never writes
# to them.
WIREGUARD_DIR=/etc/wireguard

# Where downloads are written WHILE THEY RUN. Put this on a disk you do not mind
# writing hard: torrents do sustained random writes, and a staging directory on
# the OS drive wears it out faster than anything else the machine does.
STAGING_DIR=/srv/downloads

# Where the finished media lives - the library your media server reads. Often a
# NAS mount. If it goes away, the machine panel says "unreadable" rather than
# pretending the disk is full.
LIBRARY_DIR=/srv/media

# Your provider's in-tunnel DNS resolver. The DEFAULT is Mullvad's (10.64.0.1).
# If you use a different provider you MUST set this - every client's DNS is
# force-redirected here over the tunnels, so a wrong address means nothing
# resolves at all. Proton is 10.2.0.1, PIA 10.0.0.243, AirVPN 10.128.0.1; check
# your provider's docs. Leave it commented to accept the Mullvad default.
#VPN_DNS=10.64.0.1

# The user your media files should belong to. Get them with `id -u` and `id -g`.
# Wrong values here are why imported files sometimes cannot be read by anything
# else on the machine.
PUID=1000
PGID=1000
TZ=Etc/UTC
